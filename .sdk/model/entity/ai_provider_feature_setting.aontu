# Entity: ai_provider_feature_setting

main: kit: entity: ai_provider_feature_setting: {

  alias: field: {}

  fields: {
    feature_type: {
      h: "Feature Type"
      n: "feature_type"
      r: true
      t: "`$STRING`"
    }
    inherited_model: {
      h: "Inherited Model"
      n: "inherited_model"
      r: true
      t: "`$ANY`"
    }
    inherited_state: {
      h: "Inherited State"
      n: "inherited_state"
      r: true
