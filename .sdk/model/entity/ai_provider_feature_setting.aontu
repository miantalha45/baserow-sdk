      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    mode: {
      h: "Mode"
      n: "mode"
      r: true
      sh: "* `inherit` - inherit * `legacy` - legacy * `model` - model * `disabled` - disabled"
      t: "`$STRING`"
    }
    model: {
      h: "Model"
      n: "model"
      r: true
      t: "`$ANY`"
    }
    model_id: {
      h: "Model Id"
      n: "model_id"
      r: false
      t: "`$INTEGER`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "* `configured` - configured * `inherited` - inherited * `overridden` - overridden * `disabled` - disabled * `unconfigured` - unconfigured * `invalid` - invalid"
      t: "`$STRING`"
    }
  }

  name: "ai_provider_feature_setting"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/ai-providers/features/"
