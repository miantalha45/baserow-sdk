                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/api/ai-providers/features/"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "ai-providers"
            }
            {
              lit: "features"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          bf: [
            "mode"
            "model_id"
          ]
          co: {
            id: "PUT /api/ai-providers/features/{feature_type}/"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "feature_type"
                or: "feature_type"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "workspace_id"
                or: "workspace_id"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "PUT"
          o: "/api/ai-providers/features/{feature_type}/"
          q: {
            exist: [
              "feature_type"
            ]
          }
          rb: {
            alternatives: [
              {
                fields: [
                  {
                    name: "mode"
                  }
                  {
                    name: "model_id"
                  }
                ]
                kind: "multipart"
                media: "multipart/form-data"
              }
              {
                fields: [
                  {
                    name: "mode"
                  }
                  {
                    name: "model_id"
                  }
                ]
                kind: "form"
                media: "application/x-www-form-urlencoded"
              }
            ]
            kind: "json"
            media: "application/json"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
