      n: "table_header_font_weight"
      r: false
      sh: "* `thin` - Thin * `extra-light` - Extra Light * `light` - Light * `regular` - Regular * `medium` - Medium * `semi-bold` - Semi Bold * `bold` - Bold * `extra-bold` - Extra Bold * `heavy` - Heavy * `black` - Black * `extra-black` - Extra…"
      t: "`$STRING`"
    }
    table_header_text_alignment: {
      h: "Table Header Text Alignment"
      n: "table_header_text_alignment"
      r: false
      sh: "* `left` - Left * `center` - Center * `right` - Right"
      t: "`$STRING`"
    }
    table_header_text_color: {
      h: "Table Header Text Color"
      n: "table_header_text_color"
      r: false
      sh: "The text color of the table header cells"
      t: "`$STRING`"
    }
    table_horizontal_separator_color: {
      h: "Table Horizontal Separator Color"
      n: "table_horizontal_separator_color"
      r: false
      sh: "The color of the table horizontal separator"
      t: "`$STRING`"
    }
    table_horizontal_separator_size: {
      h: "Table Horizontal Separator Size"
      n: "table_horizontal_separator_size"
      r: false
      sh: "Table horizontal separator size"
      t: "`$INTEGER`"
    }
    table_vertical_separator_color: {
      h: "Table Vertical Separator Color"
      n: "table_vertical_separator_color"
      r: false
      sh: "The color of the table vertical separator"
      t: "`$STRING`"
    }
    table_vertical_separator_size: {
      h: "Table Vertical Separator Size"
      n: "table_vertical_separator_size"
      r: false
      sh: "Table vertical separator size"
      t: "`$INTEGER`"
    }
  }

