      t: "`$INTEGER`"
    }
    first_row_header: {
      h: "First Row Header"
      n: "first_row_header"
      r: false
      sh: "Indicates if the first provided row is the header."
      t: "`$BOOLEAN`"
    }
    headers: {
      h: "Headers"
      n: "headers"
      op: {
        create: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      ro: true
