# Entity: table

main: kit: entity: table: {

  alias: field: {}

  fields: {
    active: {
      h: "Active"
      n: "active"
      r: false
      sh: "Indicates whether the web hook is active."
      t: "`$BOOLEAN`"
    }
    calls: {
      h: "Calls"
      n: "calls"
      r: true
      sh: "All the calls that this webhook made."
      t: "`$ARRAY`"
    }
    created_on: {
      fo: "date-time"
      h: "Created On"
      n: "created_on"
      r: true
      ro: true
      t: "`$STRING`"
    }
