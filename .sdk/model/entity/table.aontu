        create: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      ro: true
      sh: "A list containing the addition event options."
      t: "`$ARRAY`"
    }
    events: {
      h: "Events"
      n: "events"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      ro: true
      sh: "A list containing the events that will trigger this webhook."
      t: "`$OBJECT`"
    }
    failed_triggers: {
      h: "Failed Triggers"
      n: "failed_triggers"
      r: false
