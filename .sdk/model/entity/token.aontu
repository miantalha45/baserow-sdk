                  {
                    name: "permissions"
                  }
                  {
                    name: "rotate_key"
                  }
                ]
                kind: "multipart"
                media: "multipart/form-data"
              }
              {
                fields: [
                  {
                    name: "name"
                  }
                  {
                    name: "permissions"
                  }
                  {
                    name: "rotate_key"
                  }
                ]
                kind: "form"
