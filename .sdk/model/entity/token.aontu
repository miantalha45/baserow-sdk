    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/database/tokens/{token_id}/"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "token_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/api/database/tokens/{token_id}/"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              token_id: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "database"
            }
            {
              lit: "tokens"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          bf: [
            "name"
            "permissions"
            "rotate_key"
          ]
          co: {
            id: "PATCH /api/database/tokens/{token_id}/"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "token_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "PATCH"
          o: "/api/database/tokens/{token_id}/"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
