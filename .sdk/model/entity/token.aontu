# Entity: token

main: kit: entity: token: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: true
      ro: true
      t: "`$INTEGER`"
    }
    key: {
      h: "Key"
      n: "key"
      r: true
      sh: "The unique token key that can be used to authorize for the table row endpoints."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The human readable name of the database token for the user."
      t: "`$STRING`"
    }
    permissions: {
      h: "Permissions"
      n: "permissions"
      op: {
        update: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      sh: "Indicates per operation which permissions the database token has within the whole workspace."
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 8
        depth: 6
      }
    }
    rotate_key: {
      h: "Rotate Key"
      n: "rotate_key"
      r: false
      sh: "Indicates if a new key must be generated."
      t: "`$BOOLEAN`"
    }
    workspace: {
      h: "Workspace"
      n: "workspace"
      r: true
      sh: "Only the tables of the workspace can be accessed."
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "token"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "name"
            "workspace"
          ]
          co: {
            id: "POST /api/database/tokens/"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/database/tokens/"
          rb: {
            alternatives: [
              {
                fields: [
                  {
                    name: "name"
                  }
                  {
                    name: "workspace"
                  }
                ]
                kind: "multipart"
                media: "multipart/form-data"
              }
              {
                fields: [
                  {
                    name: "name"
                  }
                  {
                    name: "workspace"
                  }
                ]
                kind: "form"
                media: "application/x-www-form-urlencoded"
              }
            ]
            kind: "json"
            media: "application/json"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "database"
            }
            {
              lit: "tokens"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/database/tokens/"
            source: "openapi3"
            version: 2
          }
          m: "GET"
