# Entity: user

main: kit: entity: user: {

  alias: field: {}

  fields: {
    authenticate: {
      h: "Authenticate"
      n: "authenticate"
      r: false
      sh: "Indicates whether an authentication JWT should be generated and be included in the response."
      t: "`$BOOLEAN`"
    }
    captcha_token: {
      h: "Captcha Token"
      n: "captcha_token"
      r: false
      sh: "The captcha response token, required when captcha is enabled."
      t: "`$STRING`"
    }
    date_joined: {
      fo: "date-time"
      h: "Date Joined"
      n: "date_joined"
      r: false
      t: "`$STRING`"
    }
    email: {
      fo: "email"
      h: "Email"
      n: "email"
      r: true
      sh: "The email address is also going to be the username."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      ro: true
      t: "`$INTEGER`"
    }
    is_active: {
      h: "Is Active"
      n: "is_active"
      r: false
      sh: "Designates whether this user should be treated as active."
      t: "`$BOOLEAN`"
    }
    is_staff: {
      h: "Is Staff"
      n: "is_staff"
      r: false
      sh: "Designates whether this user is an admin and has access to all workspaces and Baserow's admin areas."
      t: "`$BOOLEAN`"
    }
    language: {
      h: "Language"
      n: "language"
      r: false
      sh: "An ISO 639 language code (with optional variant) selected by the user."
      t: "`$STRING`"
    }
    last_login: {
      fo: "date-time"
      h: "Last Login"
      n: "last_login"
      r: false
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      t: "`$STRING`"
    }
    password: {
      h: "Password"
      n: "password"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      t: "`$STRING`"
    }
    template_id: {
      h: "Template Id"
      n: "template_id"
      r: false
      sh: "The id of the template that must be installed after creating the account."
      t: "`$INTEGER`"
    }
    two_factor_auth: {
      h: "Two Factor Auth"
      n: "two_factor_auth"
      r: true
      ro: true
      sh: "The user's two factor auth provider state, or null when no provider is configured."
      t: "`$OBJECT`"
    }
    username: {
      fo: "email"
      h: "Username"
      n: "username"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      t: "`$STRING`"
    }
    workspace_invitation_token: {
      h: "Workspace Invitation Token"
      n: "workspace_invitation_token"
      r: false
      sh: "If provided and valid, the user accepts the workspace invitation and will have access to the workspace after signing up."
      t: "`$STRING`"
    }
    workspaces: {
      h: "Workspaces"
      n: "workspaces"
      r: true
      t: "`$ARRAY`"
    }
  }

