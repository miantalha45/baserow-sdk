# Entity: workspace

main: kit: entity: workspace: {

  alias: field: {}

  fields: {
    ai_features: {
      h: "Ai Features"
      n: "ai_features"
      r: true
      ro: true
      t: "`$STRING`"
    }
    base_url: {
      fo: "uri"
      h: "Base Url"
      n: "base_url"
      r: true
      sh: "The base URL where the user can publicly accept his invitation.The accept token is going to be appended to the base_url (base_url '/token')."
      t: "`$STRING`"
    }
    captcha_token: {
      h: "Captcha Token"
      n: "captcha_token"
      r: false
      sh: "The captcha response token, required when captcha is enabled."
      t: "`$STRING`"
    }
    created_on: {
      fo: "date-time"
      h: "Created On"
      n: "created_on"
      r: true
      ro: true
      t: "`$STRING`"
    }
    email: {
      fo: "email"
      h: "Email"
      n: "email"
      r: true
      ro: true
      sh: "The email address of the user that the invitation is meant for."
      t: "`$STRING`"
    }
    generative_ai_models_enabled: {
      h: "Generative Ai Models Enabled"
      n: "generative_ai_models_enabled"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      ro: true
      sh: "Generative AI models available in this workspace."
      t: "`$STRING`"
    }
    has_more: {
      h: "Has More"
      n: "has_more"
      r: true
      sh: "Whether there are more results available for pagination"
      t: "`$BOOLEAN`"
    }
    highest_role_uid: {
      h: "Highest Role Uid"
      n: "highest_role_uid"
      r: false
      sh: "Enterprise or advanced only: the highest role uid assigned to this user in this workspace on anything, including roles from teams."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      op: {
        update: {
          req: false
          type: "`$INTEGER`"
        }
      }
      r: true
      ro: true
      sh: "Workspace id."
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      ro: true
      sh: "User defined name."
      t: "`$STRING`"
    }
    order: {
      h: "Order"
      n: "order"
      r: true
      ro: true
      sh: "The requesting user's order within the workspace users."
      t: "`$INTEGER`"
    }
    permissions: {
      h: "Permissions"
      n: "permissions"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
        list: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      ro: true
      sh: "The permissions that the user is going to get within the workspace after accepting the invitation."
      t: "`$STRING`"
    }
    results: {
      h: "Results"
      n: "results"
      r: true
      sh: "Priority-ordered search results"
      t: "`$ARRAY`"
    }
    role_uid: {
      h: "Role Uid"
      n: "role_uid"
      r: false
      sh: "Enterprise or advanced only: the uid of the role that is assigned to this workspace user in this workspace."
      t: "`$STRING`"
    }
    teams: {
      h: "Teams"
      n: "teams"
      r: false
      sh: "Enterprise only: a list of team IDs and names, which this workspace user belongs to in this workspace."
      t: "`$ARRAY`"
    }
    to_be_deleted: {
      h: "To Be Deleted"
      n: "to_be_deleted"
      r: true
      sh: "True if user account is pending deletion."
      t: "`$BOOLEAN`"
    }
    two_factor_auth: {
      h: "Two Factor Auth"
      n: "two_factor_auth"
      r: true
      ro: true
      t: "`$STRING`"
    }
    unread_notifications_count: {
      h: "Unread Notifications Count"
      n: "unread_notifications_count"
      r: true
      ro: true
      sh: "The number of unread notifications for the requesting user."
      t: "`$INTEGER`"
    }
    user_id: {
      h: "User Id"
      n: "user_id"
      r: true
      ro: true
      sh: "The user that has access to the workspace."
      t: "`$INTEGER`"
    }
    users: {
      h: "Users"
      n: "users"
      r: true
      ro: true
      sh: "List of all workspace users."
      t: "`$ARRAY`"
    }
    workspace: {
      h: "Workspace"
      n: "workspace"
      r: true
      sh: "The workspace that the user will get access to once the invitation is accepted."
      t: "`$INTEGER`"
    }
  }

