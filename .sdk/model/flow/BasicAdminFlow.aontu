# BasicAdminFlow

main: kit: flow: BasicAdminFlow:
{
  entity: "admin",
  kind: "basic",
  name: "BasicAdminFlow",
  step: [
    {
      i: {
        ref: "admin_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "admin_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "admin_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "admin01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "admin_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAdminFlow"
}