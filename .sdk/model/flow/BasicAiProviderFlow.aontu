# BasicAiProviderFlow

main: kit: flow: BasicAiProviderFlow:
{
  entity: "ai_provider",
  kind: "basic",
  name: "BasicAiProviderFlow",
  step: [
    {
      i: {
        ref: "ai_provider_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "ai_provider_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ai_provider_ref01",
        srcdatavar: "ai_provider_ref01_data",
        suffix: "_up0",
        textfield: "api_key"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ai_provider_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ai_provider_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "ai_provider01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "ai_provider_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAiProviderFlow"
}