# BasicAutomationWorkflowFlow

main: kit: flow: BasicAutomationWorkflowFlow:
{
  entity: "automation_workflow",
  kind: "basic",
  name: "BasicAutomationWorkflowFlow",
  step: [
    {
      i: {
        ref: "automation_workflow_ref01"
      }

      m: {
        workflow_id: "workflow01"
      }

      o: "create"
    }

    {
      i: {
        ref: "automation_workflow_ref01",
        srcdatavar: "automation_workflow_ref01_data",
        suffix: "_up0",
        textfield: "error_code"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-automation_workflow_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "automation_workflow_ref01",
        srcdatavar: "automation_workflow_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "automation_workflow01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-automation_workflow_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "automation_workflow_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "automation_workflow01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicAutomationWorkflowFlow"
}