# BasicDataScanFlow

main: kit: flow: BasicDataScanFlow:
{
  entity: "data_scan",
  kind: "basic",
  name: "BasicDataScanFlow",
  step: [
    {
      i: {
        ref: "data_scan_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "data_scan_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "data_scan_ref01",
        srcdatavar: "data_scan_ref01_data",
        suffix: "_up0",
        textfield: "frequency"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-data_scan_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "data_scan_ref01",
        srcdatavar: "data_scan_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "data_scan01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-data_scan_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDataScanFlow"
}