# BasicElementFlow

main: kit: flow: BasicElementFlow:
{
  entity: "element",
  kind: "basic",
  name: "BasicElementFlow",
  step: [
    {
      i: {
        ref: "element_ref01"
      }

      m: {
        page_id: "page01"
      }

      o: "create"
    }

    {
      m: {
        page_id: "page01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "element_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "element_ref01",
        srcdatavar: "element_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-element_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicElementFlow"
}