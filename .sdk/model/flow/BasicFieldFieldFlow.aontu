# BasicFieldFieldFlow

main: kit: flow: BasicFieldFieldFlow:
{
  entity: "field_field",
  kind: "basic",
  name: "BasicFieldFieldFlow",
  step: [
    {
      i: {
        ref: "field_field_ref01"
      }

      m: {
        table_id: "table01"
      }

      o: "create"
    }

    {
      i: {
        ref: "field_field_ref01",
        srcdatavar: "field_field_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "field_field01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-field_field_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFieldFieldFlow"
}