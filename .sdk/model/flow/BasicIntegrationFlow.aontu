# BasicIntegrationFlow

main: kit: flow: BasicIntegrationFlow:
{
  entity: "integration",
  kind: "basic",
  name: "BasicIntegrationFlow",
  step: [
    {
      i: {
        ref: "integration_ref01"
      }

      m: {
        application_id: "application01"
      }

      o: "create"
    }

    {
      m: {
        application_id: "application01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "integration_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "integration_ref01",
        srcdatavar: "integration_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-integration_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "integration_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "integration01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        application_id: "application01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "integration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIntegrationFlow"
}