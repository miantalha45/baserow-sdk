# BasicIntegrationServiceDashboardDataSourceFlow

main: kit: flow: BasicIntegrationServiceDashboardDataSourceFlow:
{
  entity: "integration_service_dashboard_data_source",
  kind: "basic",
  name: "BasicIntegrationServiceDashboardDataSourceFlow",
  step: [
    {
      m: {
        dashboard_id: "dashboard01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "integration_service_dashboard_data_source_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "integration_service_dashboard_data_source_ref01",
        srcdatavar: "integration_service_dashboard_data_source_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-integration_service_dashboard_data_source_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIntegrationServiceDashboardDataSourceFlow"
}