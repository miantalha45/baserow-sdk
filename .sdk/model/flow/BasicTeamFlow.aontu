# BasicTeamFlow

main: kit: flow: BasicTeamFlow:
{
  entity: "team",
  kind: "basic",
  name: "BasicTeamFlow",
  step: [
    {
      i: {
        ref: "team_ref01"
      }

      m: {
        workspace_id: "workspace01"
      }

      o: "create"
    }

    {
      i: {
        ref: "team_ref01",
        srcdatavar: "team_ref01_data",
        suffix: "_up0",
        textfield: "default_role"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-team_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "team_ref01",
        srcdatavar: "team_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "team01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-team_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "team_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "team01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicTeamFlow"
}