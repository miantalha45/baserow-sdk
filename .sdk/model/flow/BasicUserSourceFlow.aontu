# BasicUserSourceFlow

main: kit: flow: BasicUserSourceFlow:
{
  entity: "user_source",
  kind: "basic",
  name: "BasicUserSourceFlow",
  step: [
    {
      i: {
        ref: "user_source_ref01"
      }

      m: {
        application_id: "application01"
      }

      o: "create"
    }

    {
      m: {
        application_id: "application01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "user_source_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "user_source_ref01",
        srcdatavar: "user_source_ref01_data",
        suffix: "_up0",
        textfield: "RelayState"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-user_source_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "user_source_ref01",
        srcdatavar: "user_source_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "user_source01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-user_source_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "user_source_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "user_source01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        application_id: "application01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "user_source_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicUserSourceFlow"
}